{
  "name": "meural-signage",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted signage dashboard (weather, Spotify, Entetsu bus, train status, Google Calendar) rendered in a headless browser and streamed to a Meural Canvas via meural-hls.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @meural-signage/shared build && pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @meural-signage/shared build && pnpm --filter @meural-signage/web dev",
    "dev:server": "pnpm --filter @meural-signage/shared build && pnpm --filter @meural-signage/server dev",
    "build": "pnpm -r build",
    "start": "node server/dist/index.js",
    "stream": "node server/dist/index.js --stream",
    "auth:spotify": "pnpm --filter @meural-signage/server auth:spotify",
    "auth:google": "pnpm --filter @meural-signage/server auth:google",
    "typecheck": "pnpm --filter @meural-signage/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @meural-signage/shared build && pnpm --filter @meural-signage/server test",
    "browser:install": "pnpm --filter @meural-signage/server exec playwright install chromium",
    "test:stream": "pnpm build && node scripts/smoke-stream.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.6"
}
