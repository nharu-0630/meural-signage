# Optional env overrides. Anything here beats config.json.
# Copy to .env (gitignored). dotenv is loaded on startup.

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Create an app, add redirect URI http://127.0.0.1:7000/auth/spotify/callback,
# then run:  npm run auth:spotify   to obtain a refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Google Calendar (https://console.cloud.google.com) ---
# OAuth client (Desktop or Web), enable Calendar API, scope calendar.readonly.
# Redirect URI http://127.0.0.1:7000/auth/google/callback, then:  npm run auth:google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Server ---
# PORT=7000

# --- Streaming to the Meural Canvas (consumed by meural-hls) ---
# After `npm run stream`, point meural-hls at the local HLS stream:
#   HLS_URL=http://127.0.0.1:7000/hls/live.m3u8 python3 mac/hls_push.py
# MEURAL_SIGNAGE_STREAM=1
