{
  "name": "@meural-signage/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "auth:spotify": "tsx src/auth/spotify-auth.ts",
    "auth:google": "tsx src/auth/google-auth.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "playwright": "^1.50.1",
    "@meural-signage/shared": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
